# --- Secrets: never commit ---
.env
.env.*
!.env.example
.streamlit/secrets.toml

# --- Contact data: never commit ---
# Tracker imports and exports contain personal data; keep them out of Git entirely.
data/
exports/
backups/
*.csv
*.xlsx
*.xls
*.sql
*.dump
# Exception: the made-up test files (no real people) the tests need.
!tests/fixtures/*.csv

# --- Python ---
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
build/
dist/

# --- Editors / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db
